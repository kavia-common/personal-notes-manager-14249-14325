---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About • Ocean Notes">
  <section class="card container" style="margin-top:1rem; padding:1rem;">
    <h2 style="margin:.2rem 0 0 0;">About Ocean Notes</h2>
    <p class="help">Ocean Notes is a minimalist notes manager designed with an ocean-inspired palette and smooth interactions.</p>
    <ul>
      <li>Create and edit notes with ease</li>
      <li>Organize using categories and tags</li>
      <li>Search instantly across your content</li>
    </ul>
  </section>
</Layout>
