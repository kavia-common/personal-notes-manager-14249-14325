---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import NotesList from '../../components/NotesList.astro';
import NoteEditor from '../../components/NoteEditor.astro';
import { listNotes, getNote, getCategories } from '../../services/api';

export async function getStaticPaths() {
  // During build time, return a dummy path that will be replaced at runtime
  return [
    { params: { id: 'placeholder' } }
  ];
}

// Get data
let categories: string[] = [];
let notes = [];
let note = null;
let query = '';
let category = '';

// Skip data fetching during build
if (import.meta.env.SSR && !import.meta.env.DEV) {
  categories = [];
  notes = [];
} else {
  try {
    const { id } = Astro.params;
    categories = await getCategories();
    const searchParams = Astro.url.searchParams;
    query = searchParams.get('query') || '';
    category = searchParams.get('category') || '';
    
    [notes, note] = await Promise.all([
      listNotes({ query, category }),
      getNote(id)
    ]);
  } catch (error) {
    console.error('Failed to fetch data:', error);
  }
}
---

<Layout title="Edit Note • Ocean Notes">
  <Sidebar categories={categories} active={category} />
  <section>
    <div class="notes-header">
      <div class="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M21 21l-4.3-4.3M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input id="searchInput" type="search" placeholder="Search notes..." value={query} />
      </div>
      <div style="display:flex; gap:.5rem;">
        <a href="/app/new" class="btn primary">New Note</a>
      </div>
    </div>

    <div class="notes-grid">
      <div class="card" style="padding:.5rem;">
        <NotesList notes={notes} activeId={note?.id} />
      </div>
      <NoteEditor note={note} />
    </div>
  </section>

  <script>
    function initSearch() {
      const input = document.getElementById('searchInput') as HTMLInputElement | null;
      if (!input) return;
      let t: number | undefined;
      input.addEventListener('input', () => {
        if (t) window.clearTimeout(t);
        t = window.setTimeout(() => {
          const url = new URL(window.location.href);
          if (input.value) url.searchParams.set('query', input.value);
          else url.searchParams.delete('query');
          window.location.href = url.toString();
        }, 350);
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSearch);
    else initSearch();
  </script>
</Layout>
