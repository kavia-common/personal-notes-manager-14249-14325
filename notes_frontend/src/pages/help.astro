---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Help • Ocean Notes">
  <section class="card container" style="margin-top:1rem; padding:1rem;">
    <h2 style="margin:.2rem 0 0 0;">Help & Shortcuts</h2>
    <p class="help">Use search in the app to quickly find notes. Use tags like "todo" or "idea" to categorize.</p>
    <ul>
      <li>Click "New Note" to create a note</li>
      <li>Use the sidebar to filter by category</li>
      <li>Delete from within the editor</li>
    </ul>
  </section>
</Layout>
