---
import ThemeToggle from './ThemeToggle.astro';
const isAuthed = true; // Client-side will adjust based on token presence
---

<header class="header">
  <div class="header-inner container">
    <a href="/" class="brand" aria-label="Notes Home">
      <span class="brand-badge"></span>
      <span>Ocean Notes</span>
    </a>

    <nav class="nav">
      <a class="btn" href="/app">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Notes
      </a>
      <a class="btn" href="/about">About</a>
      <a class="btn" href="/help">Help</a>
      <a class="btn secondary" href="/auth/login">Sign in</a>
    </nav>
  </div>
  <ThemeToggle />
</header>

<script>
  // Adjust header auth button based on token
  function swapAuthButtons() {
    const token = typeof localStorage !== 'undefined' ? localStorage.getItem('token') : null;
    const nav = document.querySelector('.nav');
    if (!nav) return;
    const existingAuth = nav.querySelector('[data-auth-action]');
    if (existingAuth) existingAuth.remove();

    const a = document.createElement('a');
    a.className = 'btn secondary';
    a.setAttribute('data-auth-action', 'true');
    if (token) {
      a.href = '/auth/logout';
      a.textContent = 'Sign out';
    } else {
      a.href = '/auth/login';
      a.textContent = 'Sign in';
    }
    nav.appendChild(a);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', swapAuthButtons);
  } else {
    swapAuthButtons();
  }
</script>
